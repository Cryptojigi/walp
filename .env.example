# ==============================================================================
# Walp Local Environment Configuration (Copy to .env — NEVER commit .env)
# ==============================================================================

# NEAR AI Cloud TEE API key (from https://nearbuilders.org/dashboard or https://cloud.near.ai)
# Served via https://cloud-api.near.ai/v1 — kept server-side only, never exposed to Vite client.
NEAR_AI_API_KEY=

# Wallet A — Owner Account (Full-Access Key; ONLY used locally by CLI deploy/admin scripts)
NEAR_OWNER_ACCOUNT_ID=your-owner.testnet
NEAR_OWNER_PRIVATE_KEY=

# Deployed NEAR Contracts (created as subaccounts under NEAR_OWNER_ACCOUNT_ID)
WALP_VAULT_CONTRACT_ID=walp-vault.your-owner.testnet
WALP_REGISTRY_CONTRACT_ID=walp-registry.your-owner.testnet
MPC_CONTRACT_ID=v1.signer-prod.testnet

# Wallet B — Scoped Agent Account (Zero Full-Access Keys onchain; FunctionCall key ONLY)
# Restricted solely to request_intent on WALP_VAULT_CONTRACT_ID.
NEAR_AGENT_ACCOUNT_ID=agent.your-owner.testnet
NEAR_AGENT_PRIVATE_KEY=

# Optional RPC Overrides
NEAR_RPC_URL=https://test.rpc.fastnear.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Local API Proxy Server Port
PORT=3001
